"""z3-solver (z3py) の部分スタブ.

z3-solver は型情報 (py.typed) を同梱しておらず、strict モードの pyright では
ほぼすべての API が Unknown になる。そこで sc/ で実際に使う API だけを、
実行時の実装 (z3/z3.py) に合わせて型付けしたスタブを用意する。

- 引数名・既定値は実装に一致させる (mypy の stubtest で検証: README 参照)。
- 実装が受け付ける型のうち、sc/ で使う型だけを宣言している (意図的に狭い)。
- ``ctx`` 引数は sc/ では使わないので省略せず ``None`` 既定で残す。
"""

from collections.abc import Sequence

class Z3Exception(Exception):  # noqa: N818  (z3 の実装名)
    value: object
    def __init__(self, value: object) -> None: ...

class Context:
    def __init__(self, *args: object, **kws: object) -> None: ...

class Z3PPObject: ...

class AstRef(Z3PPObject):
    # ast は C API のポインタ (ctypes)。sc/ からは直接生成しない
    def __init__(self, ast: object, ctx: Context | None = None) -> None: ...
    def eq(self, other: AstRef) -> bool: ...
    def hash(self) -> int: ...
    def sexpr(self) -> str: ...
    def __hash__(self) -> int: ...
    def __bool__(self) -> bool: ...

class SortRef(AstRef):
    def name(self) -> str: ...

class BoolSortRef(SortRef): ...

class DatatypeSortRef(SortRef):
    def num_constructors(self) -> int: ...
    def constructor(self, idx: int) -> FuncDeclRef: ...
    def recognizer(self, idx: int) -> FuncDeclRef: ...
    def accessor(self, i: int, j: int) -> FuncDeclRef: ...

class FuncDeclRef(AstRef):
    def name(self) -> str: ...
    def arity(self) -> int: ...
    def domain(self, i: int) -> SortRef: ...
    def range(self) -> SortRef: ...
    def __call__(self, *args: ExprRef) -> ExprRef: ...

class ExprRef(AstRef):
    def sort(self) -> SortRef: ...
    def decl(self) -> FuncDeclRef: ...
    def children(self) -> list[ExprRef]: ...
    def num_args(self) -> int: ...
    def arg(self, idx: int) -> ExprRef: ...
    # z3 は == / != を「論理式を作る演算子」として上書きしている (object.__eq__ と非互換)
    def __eq__(self, other: ExprRef) -> BoolRef: ...  # type: ignore[override]  # pyright: ignore[reportIncompatibleMethodOverride]
    def __ne__(self, other: ExprRef) -> BoolRef: ...  # type: ignore[override]  # pyright: ignore[reportIncompatibleMethodOverride]
    def __hash__(self) -> int: ...

class BoolRef(ExprRef):
    def sort(self) -> BoolSortRef: ...

class QuantifierRef(BoolRef):
    def body(self) -> ExprRef: ...
    def num_vars(self) -> int: ...
    def var_name(self, idx: int) -> str: ...
    def var_sort(self, idx: int) -> SortRef: ...
    def is_forall(self) -> bool: ...
    def is_exists(self) -> bool: ...

class DatatypeRef(ExprRef):
    def sort(self) -> DatatypeSortRef: ...

class CheckSatResult:
    r: int
    def __init__(self, r: int) -> None: ...

sat: CheckSatResult
unsat: CheckSatResult
unknown: CheckSatResult

class ModelRef:
    def __init__(self, m: object, ctx: Context) -> None: ...
    def eval(self, t: ExprRef, model_completion: bool = False) -> ExprRef: ...

class Solver:
    def __init__(
        self, solver: None = None, ctx: Context | None = None, logFile: None = None
    ) -> None: ...
    def add(self, *args: BoolRef) -> None: ...
    def set(self, *args: str | int | bool, **keys: str | int | bool) -> None: ...
    def check(self, *assumptions: BoolRef) -> CheckSatResult: ...
    def model(self) -> ModelRef: ...
    def push(self) -> None: ...
    def pop(self, num: int = 1) -> None: ...
    def reason_unknown(self) -> str: ...

class Datatype:
    name: str
    def __init__(self, name: str, ctx: Context | None = None) -> None: ...
    def declare(self, name: str, *args: tuple[str, SortRef | Datatype]) -> None: ...
    def create(self) -> DatatypeSortRef: ...

def BoolSort(ctx: Context | None = None) -> BoolSortRef: ...
def BoolVal(val: bool, ctx: Context | None = None) -> BoolRef: ...
def And(*args: BoolRef) -> BoolRef: ...
def Or(*args: BoolRef) -> BoolRef: ...
def Not(a: BoolRef, ctx: Context | None = None) -> BoolRef: ...
def Implies(a: BoolRef, b: BoolRef, ctx: Context | None = None) -> BoolRef: ...
def If(a: BoolRef, b: ExprRef, c: ExprRef, ctx: Context | None = None) -> ExprRef: ...
def Distinct(*args: ExprRef) -> BoolRef: ...
def ForAll(
    vs: list[ExprRef],
    body: BoolRef,
    weight: int = 1,
    qid: str = "",
    skid: str = "",
    patterns: list[ExprRef] = [],
    no_patterns: list[ExprRef] = [],
) -> BoolRef: ...
def Exists(
    vs: list[ExprRef],
    body: BoolRef,
    weight: int = 1,
    qid: str = "",
    skid: str = "",
    patterns: list[ExprRef] = [],
    no_patterns: list[ExprRef] = [],
) -> BoolRef: ...
def Const(name: str, sort: SortRef) -> ExprRef: ...
def Function(name: str, *sig: SortRef) -> FuncDeclRef: ...
def RecFunction(name: str, *sig: SortRef) -> FuncDeclRef: ...
def RecAddDefinition(f: FuncDeclRef, args: list[ExprRef], body: ExprRef) -> None: ...
def EnumSort(
    name: str, values: Sequence[str], ctx: Context | None = None
) -> tuple[DatatypeSortRef, list[ExprRef]]: ...
def substitute(t: ExprRef, *m: tuple[ExprRef, ExprRef]) -> ExprRef: ...
def substitute_funs(t: ExprRef, *m: tuple[FuncDeclRef, ExprRef]) -> ExprRef: ...
def simplify(a: ExprRef, *arguments: str | int | bool, **keywords: str | int | bool) -> ExprRef: ...
def Var(idx: int, s: SortRef) -> ExprRef: ...
def is_app(a: AstRef) -> bool: ...
def is_const(a: AstRef) -> bool: ...
def is_var(a: AstRef) -> bool: ...
def is_quantifier(a: AstRef) -> bool: ...
def is_true(a: AstRef) -> bool: ...
def is_false(a: AstRef) -> bool: ...
def is_bool(a: AstRef) -> bool: ...
def get_var_index(a: AstRef) -> int: ...
def substitute_vars(t: ExprRef, *m: ExprRef) -> ExprRef: ...
def is_eq(a: AstRef) -> bool: ...
def is_and(a: AstRef) -> bool: ...
